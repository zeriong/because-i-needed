{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "resolved", "verdict"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "issue", "evidence", "suggestion"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor", "nit"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "resolved": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string", "enum": ["pass", "changes_requested"] }
  }
}
